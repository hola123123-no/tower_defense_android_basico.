def guardar_partida(mostrar=True):
    datos={"version":1,"dinero":dinero,"vida_jugador":vida_jugador,"oleada":oleada,
           "dificultad_actual":dificultad_actual,"velocidad_juego":velocidad_juego,
           "multiplicador_dificultad":multiplicador_dificultad,"spawn_timer":spawn_timer,
           "torres":[t.a_dict() for t in torres],"enemigos":[e.a_dict() for e in enemigos],
           "enemigos_por_aparecer":[e.a_dict() for e in enemigos_por_aparecer]}
    try:
        with open(ARCHIVO_PARTIDA,"w",encoding="utf-8") as f: json.dump(datos,f,ensure_ascii=False,indent=2)
        if mostrar: mensaje("Partida guardada")
        return True
    except (OSError,TypeError,ValueError):
        if mostrar: mensaje("Error al guardar")
        return False

def cargar_partida(mostrar=True):
    global dinero,vida_jugador,oleada,dificultad_actual,velocidad_juego,multiplicador_dificultad
    global spawn_timer,torres,enemigos,enemigos_por_aparecer,torre_seleccionada_mapa,tipo_seleccionado,modo
    try:
        with open(ARCHIVO_PARTIDA,"r",encoding="utf-8") as f: d=json.load(f)
        dificultad=d.get("dificultad_actual","normal")
        if dificultad not in DIFICULTADES: dificultad="normal"
        dificultad_actual=dificultad; dinero=int(d.get("dinero",350)); vida_jugador=int(d.get("vida_jugador",10))
        oleada=max(1,int(d.get("oleada",1))); velocidad_juego=int(d.get("velocidad_juego",1))
        if velocidad_juego not in (1,2): velocidad_juego=1
        multiplicador_dificultad=float(d.get("multiplicador_dificultad",1))
        spawn_timer=float(d.get("spawn_timer",0))
        torres=[Torre.desde_dict(t) for t in d.get("torres",[])]
        enemigos=[Enemigo.desde_dict(e) for e in d.get("enemigos",[])]
        enemigos_por_aparecer=[Enemigo.desde_dict(e) for e in d.get("enemigos_por_aparecer",[])]
        torre_seleccionada_mapa=None; tipo_seleccionado=None; modo="juego"; actualizar_record()
        if mostrar: mensaje("Partida cargada")
        return True
    except (OSError,ValueError,TypeError,KeyError,json.JSONDecodeError):
        if mostrar: mensaje("No hay una partida valida")
        return False

