            if modo=="juego" and vida_jugador>0: guardar_partida(False)
            ejecutando=False
        if evento.type==pygame.MOUSEBUTTONDOWN:
            p=evento.pos
            if modo=="menu":
                if btn_facil.collidepoint(p): iniciar_partida("facil")
                elif btn_normal.collidepoint(p): iniciar_partida("normal")
                elif btn_dificil.collidepoint(p): iniciar_partida("dificil")
                elif btn_continuar.collidepoint(p) and os.path.exists(ARCHIVO_PARTIDA): cargar_partida()
                elif btn_salir.collidepoint(p): ejecutando=False
            elif modo=="gameover":
                if btn_go_menu.collidepoint(p): modo="menu"
                elif btn_go_reintentar.collidepoint(p): iniciar_partida(dificultad_actual)
            elif modo=="juego":
                if rect_turbo.collidepoint(p):
                    velocidad_juego=2 if velocidad_juego==1 else 1; continue
                if rect_guardar.collidepoint(p): guardar_partida(); continue
                if rect_cargar.collidepoint(p): cargar_partida(); continue
                if torre_seleccionada_mapa and torre_seleccionada_mapa.nivel<5 and rect_mejorar.collidepoint(p):
                    costo=torre_seleccionada_mapa.nivel*100
                    if dinero>=costo:
                        dinero-=costo; torre_seleccionada_mapa.mejorar(); mensaje("Torre mejorada")
                    else: mensaje("No tenes suficiente oro")
                    continue
                if torre_seleccionada_mapa and rect_vender.collidepoint(p):
                    reembolso=int(torre_seleccionada_mapa.invertido*0.5); dinero+=reembolso
                    if torre_seleccionada_mapa in torres: torres.remove(torre_seleccionada_mapa)
                    torre_seleccionada_mapa=None; tipo_seleccionado=None; mensaje(f"Torre vendida: +${reembolso}")
                    continue
                tocado=False
                for b in botones_torres:
                    if b["rect"].collidepoint(p):
                        if dinero>=COSTOS[b["tipo"]]: tipo_seleccionado=b["tipo"]; torre_seleccionada_mapa=None
                        else: mensaje("No tenes suficiente oro")
                        tocado=True; break
                if tocado: continue
                x,y=p
                if 210<=y<830:
                    tocada=next((t for t in torres if math.hypot(t.x-x,t.y-y)<25),None)
                    if tocada: torre_seleccionada_mapa=tocada; tipo_seleccionado=None
                    elif tipo_seleccionado:
                        if not any(math.hypot(t.x-x,t.y-y)<30 for t in torres):
                            torres.append(Torre(x,y,tipo_seleccionado)); dinero-=COSTOS[tipo_seleccionado]; tipo_seleccionado=None
                        else: mensaje("No coloques torres tan juntas")
                    else: torre_seleccionada_mapa=None

    if not ejecutando: break

    if modo=="juego" and vida_jugador>0:
        if enemigos_por_aparecer:
            spawn_timer+=velocidad_juego
            if spawn_timer>=45: enemigos.append(enemigos_por_aparecer.pop(0)); spawn_timer=0
        for t in torres: t.atacar(enemigos,velocidad_juego)
        for e in enemigos[:]:
            if e.vida<=0:
                dinero+=150 if e.jefe else (35 if e.tipo in INMUNIDADES else 25); enemigos.remove(e); continue
            sigue=e.actualizar(velocidad_juego)
            if e.vida<=0:
                dinero+=150 if e.jefe else (35 if e.tipo in INMUNIDADES else 25); enemigos.remove(e); continue
            if not sigue: vida_jugador-=1; enemigos.remove(e)
        if not enemigos and not enemigos_por_aparecer and vida_jugador>0:
            oleada+=1; enemigos_por_aparecer=generar_oleada(oleada); actualizar_record()
            guardar_partida(False)
    if modo=="juego" and vida_jugador<=0:
        actualizar_record(); modo="gameover"
    if mensaje_timer>0: mensaje_timer-=1

    if modo=="menu":
        dibujar_menu()
        if mensaje_timer>0 and mensaje_temporal:
            img=FUENTE.render(mensaje_temporal,True,BLANCO); pantalla.blit(img,(ANCHO//2-img.get_width()//2,690))
    else:
        pantalla.fill(NEGRO); pygame.draw.lines(pantalla,GRIS,False,CAMINO,35)
        for t in torres:
            t.dibujar(pantalla)
            if t==torre_seleccionada_mapa: pygame.draw.circle(pantalla,BLANCO,(t.x,t.y),int(t.rango),2)
        if tipo_seleccionado and 210<=pos_mouse[1]<830:
            pygame.draw.circle(pantalla,(100,100,100),pos_mouse,110,1)
            pygame.draw.circle(pantalla,COLORES_TORRES[tipo_seleccionado],pos_mouse,18,2)
        for e in enemigos: e.dibujar(pantalla)
        pygame.draw.rect(pantalla,(25,25,25),(0,830,ANCHO,110)); pygame.draw.line(pantalla,GRIS_CLARO,(0,830),(ANCHO,830),2)
        for txt,pos,col in [(f"Vidas: {vida_jugador}",(18,12),ROJO),(f"Oro: ${dinero}",(190,12),VERDE),(f"Oleada: {oleada}",(390,12),BLANCO)]:
            pantalla.blit(FUENTE_BIG.render(txt,True,col),pos)
        aj=DIFICULTADES[dificultad_actual]
        pantalla.blit(FUENTE.render(f"Dificultad: {aj['nombre']} | Vida enemigos x{multiplicador_dificultad:.2f}",True,GRIS_CLARO),(18,44))
        pantalla.blit(FUENTE_P.render(f"Record: {record_oleada}",True,BLANCO),(420,48))
        if torre_seleccionada_mapa:
            costo=torre_seleccionada_mapa.nivel*100
            boton(pantalla,rect_mejorar,f"MEJORAR ${costo}" if torre_seleccionada_mapa.nivel<5 else "NIVEL MAX. 5",
                  VERDE if torre_seleccionada_mapa.nivel<5 and dinero>=costo else GRIS)
            boton(pantalla,rect_vender,"VENDER 50%",ROJO_OSCURO)
            info=FUENTE.render(f"{torre_seleccionada_mapa.tipo.upper()} | Nivel {torre_seleccionada_mapa.nivel} | Dano {torre_seleccionada_mapa.danio:.1f}",True,BLANCO)
            pantalla.blit(info,(18,123))
        else:
            boton(pantalla,rect_mejorar,"MEJORAR",GRIS); boton(pantalla,rect_vender,"VENDER",GRIS)
        boton(pantalla,rect_guardar,"GUARDAR",(45,100,65)); boton(pantalla,rect_cargar,"CARGAR",(70,75,100))
        boton(pantalla,rect_turbo,"TURBO 2X" if velocidad_juego==2 else "VELOCIDAD 1X",VERDE if velocidad_juego==2 else GRIS)
        nombres={"normal":"Normal","hielo":"Hielo","fuego":"Fuego","electrica":"Electrica"}
        for b in botones_torres:
            sel=tipo_seleccionado==b["tipo"]
            pygame.draw.rect(pantalla,b["color"],b["rect"],4 if sel else 0,4)
            tc=BLANCO if sel else NEGRO
            img1=FUENTE_P.render(nombres[b["tipo"]],True,tc); img2=FUENTE.render(f"${COSTOS[b['tipo']]}",True,tc)
            pantalla.blit(img1,(b["rect"].centerx-img1.get_width()//2,b["rect"].y+9))
            pantalla.blit(img2,(b["rect"].centerx-img2.get_width()//2,b["rect"].y+31))
        if mensaje_timer>0 and mensaje_temporal:
            caja=pygame.Rect(80,205,ANCHO-160,30); pygame.draw.rect(pantalla,(35,35,35),caja,0,5)
            img=FUENTE.render(mensaje_temporal,True,BLANCO); pantalla.blit(img,(caja.centerx-img.get_width()//2,caja.y+7))
        if modo=="gameover": dibujar_gameover()
    pygame.display.flip()

pygame.quit()
sys.exit()
