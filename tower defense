class Enemigo:
    def __init__(self,tipo,mult,jefe=False,tipo_jefe=None,num_oleada=1,vel_mult=1.0,vida_dificultad=1.0):
        self.tipo=tipo; self.jefe=jefe; self.tipo_jefe=tipo_jefe
        self.camino_idx=0; self.x,self.y=CAMINO[0]
        self.mult=mult; self.vel_mult=vel_mult
        self.tiempo_hielo=0.0; self.tiempo_paralizado=0.0
        self.tiempo_fuego=0.0; self.fuego_timer_tick=0.0
        if jefe:
            datos={
                "coloso":(3000,0.70,MORADO,"COLOSO"),
                "llamas":(4500,0.65,NARANJA,"SENOR DE LAS LLAMAS"),
                "destructor":(6500,0.60,(225,45,55),"DESTRUCTOR"),
            }
            vida,vel,color,nombre=datos.get(tipo_jefe,datos["coloso"])
            escala=1.0+max(0,num_oleada//10-1)*0.18
            self.vida_max=vida*vida_dificultad*escala
            self.vel_base=vel; self.color=color; self.nombre_jefe=nombre
        elif tipo in INMUNIDADES:
            self.vida_max=200*mult; self.vel_base=1.0
            self.color=INMUNIDADES[tipo]["color"]; self.nombre_jefe=""
        elif tipo=="normal":
            self.vida_max=150*mult; self.vel_base=1.5; self.color=VERDE; self.nombre_jefe=""
        elif tipo=="veloz":
            self.vida_max=100*mult; self.vel_base=2.25; self.color=AZUL; self.nombre_jefe=""
        else:
            self.vida_max=200*mult; self.vel_base=1.0; self.color=ROJO; self.nombre_jefe=""
        self.vida=self.vida_max

    def actualizar(self,vel_juego):
        vel=self.vel_base*self.vel_mult*vel_juego
        if self.tiempo_paralizado>0:
            self.tiempo_paralizado=max(0,self.tiempo_paralizado-(1/60)*vel_juego); vel=0
        elif self.tiempo_hielo>0:
            self.tiempo_hielo=max(0,self.tiempo_hielo-(1/60)*vel_juego); vel*=0.75
        if self.tiempo_fuego>0:
            self.tiempo_fuego=max(0,self.tiempo_fuego-(1/60)*vel_juego)
            self.fuego_timer_tick+=vel_juego
            while self.fuego_timer_tick>=30:
                self.vida-=3.75; self.fuego_timer_tick-=30
        if self.camino_idx<len(CAMINO)-1:
            dx=CAMINO[self.camino_idx+1][0]-self.x
            dy=CAMINO[self.camino_idx+1][1]-self.y
            dist=math.hypot(dx,dy)
            if dist<=vel or dist==0:
                self.x,self.y=CAMINO[self.camino_idx+1]; self.camino_idx+=1
            elif vel>0:
                self.x+=(dx/dist)*vel; self.y+=(dy/dist)*vel
            return True
        return False

    def dibujar(self,sup):
        radio=22 if self.jefe else (16 if self.tipo in INMUNIDADES else 14)
        pygame.draw.circle(sup,self.color,(int(self.x),int(self.y)),radio)
        if self.tipo in INMUNIDADES:
            icono_inmunidad(sup,self.tipo,self.x,self.y,1)
            pygame.draw.circle(sup,BLANCO,(int(self.x),int(self.y)),radio,1)
        ancho=30 if self.jefe else 26
        pct=max(0,min(1,self.vida/self.vida_max))
        pygame.draw.rect(sup,ROJO,(int(self.x)-ancho//2,int(self.y)-radio-10,ancho,5))
        pygame.draw.rect(sup,VERDE,(int(self.x)-ancho//2,int(self.y)-radio-10,int(ancho*pct),5))
        if self.jefe:
            img=FUENTE_P.render(self.nombre_jefe,True,BLANCO)
            sup.blit(img,(int(self.x)-img.get_width()//2,int(self.y)-radio-30))

    def a_dict(self):
        return {"tipo":self.tipo,"jefe":self.jefe,"tipo_jefe":self.tipo_jefe,"camino_idx":self.camino_idx,
                "x":self.x,"y":self.y,"vida_max":self.vida_max,"vida":self.vida,"vel_base":self.vel_base,
                "color":list(self.color),"mult":self.mult,"vel_mult":self.vel_mult,"tiempo_hielo":self.tiempo_hielo,
                "tiempo_paralizado":self.tiempo_paralizado,"tiempo_fuego":self.tiempo_fuego,
                "fuego_timer_tick":self.fuego_timer_tick,"nombre_jefe":getattr(self,"nombre_jefe","")}

    @classmethod
    def desde_dict(cls,d):
        obj=cls(d["tipo"],d.get("mult",1),d.get("jefe",False),d.get("tipo_jefe"),
                vel_mult=d.get("vel_mult",1))
        obj.camino_idx=int(d.get("camino_idx",0)); obj.x=float(d.get("x",0)); obj.y=float(d.get("y",250))
        obj.vida_max=float(d.get("vida_max",obj.vida_max)); obj.vida=float(d.get("vida",obj.vida))
        obj.vel_base=float(d.get("vel_base",obj.vel_base)); obj.color=tuple(d.get("color",obj.color))
        obj.tiempo_hielo=float(d.get("tiempo_hielo",0)); obj.tiempo_paralizado=float(d.get("tiempo_paralizado",0))
        obj.tiempo_fuego=float(d.get("tiempo_fuego",0)); obj.fuego_timer_tick=float(d.get("fuego_timer_tick",0))
        obj.nombre_jefe=d.get("nombre_jefe",getattr(obj,"nombre_jefe",""))
        return obj

class Torre:
    def __init__(self,x,y,tipo):
        self.x=int(x); self.y=int(y); self.tipo=tipo; self.nivel=1
        self.rango=120 if tipo=="electrica" else 110
        self.cooldown_max=int((0.60 if tipo=="electrica" else 0.50)*60); self.cooldown=0
        self.costo_base=COSTOS[tipo]; self.invertido=self.costo_base
        self.danio_base={"normal":25,"hielo":12.5,"fuego":37.5,"electrica":25}[tipo]
        self.danio=self.danio_base; self.color=COLORES_TORRES[tipo]

    def mejorar(self):
        if self.nivel<5:
            self.nivel+=1; self.rango+=15; self.danio=self.danio_base*self.nivel
            self.invertido+=(self.nivel-1)*100

    def puede_danar(self,e):
        return not ((e.tipo=="inmune_fuego" and self.tipo=="fuego") or
                    (e.tipo=="inmune_hielo" and self.tipo=="hielo") or
                    (e.tipo=="inmune_normal" and self.tipo=="normal") or
                    (e.tipo=="inmune_electrica" and self.tipo=="electrica"))

    def atacar(self,enemigos,vel_juego):
        if self.cooldown>0:
            self.cooldown-=vel_juego; return
        candidatos=[e for e in enemigos if e.vida>0 and self.puede_danar(e)
                    and math.hypot(e.x-self.x,e.y-self.y)<=self.rango]
        if not candidatos: return
        objetivo=candidatos[0]
        if self.tipo=="normal":
            if self.nivel>=5 and random.random()<0.40:
                for i in range(3):
                    d=candidatos[i] if i<len(candidatos) else objetivo
                    d.vida-=self.danio
            else: objetivo.vida-=self.danio
        elif self.tipo=="fuego":
            objetivo.vida-=self.danio
            if objetivo.tipo!="inmune_fuego":
                objetivo.tiempo_fuego=2.0; objetivo.fuego_timer_tick=0
            if self.nivel>=5 and random.random()<0.30:
                for e in enemigos:
                    if e is not objetivo and e.vida>0 and self.puede_danar(e) and math.hypot(e.x-objetivo.x,e.y-objetivo.y)<=65:
                        e.vida-=self.danio*0.60
        elif self.tipo=="hielo":
            objetivo.vida-=self.danio
            if objetivo.tipo!="inmune_hielo":
                objetivo.tiempo_hielo=4.0
                if self.nivel>=5 and random.random()<0.35:
                    objetivo.tiempo_paralizado=max(objetivo.tiempo_paralizado,1.5)
        else:
            objetivo.vida-=self.danio
            if self.nivel>=5 and random.random()<0.25:
                for e in enemigos:
                    if e.vida>0 and self.puede_danar(e) and math.hypot(e.x-objetivo.x,e.y-objetivo.y)<=100:
                        e.vida-=60
        self.cooldown=self.cooldown_max

    def dibujar(self,sup):
        pygame.draw.circle(sup,(40,40,40),(self.x,self.y),int(self.rango),1)
        pygame.draw.circle(sup,self.color,(self.x,self.y),18)
        pygame.draw.circle(sup,BLANCO,(self.x,self.y),18,2)
        if self.tipo=="fuego":
            pygame.draw.polygon(sup,(255,205,70),[(self.x,self.y-10),(self.x+7,self.y+2),(self.x,self.y+9),(self.x-6,self.y+2)])
        elif self.tipo=="hielo": icono_inmunidad(sup,"inmune_hielo",self.x,self.y,0.75)
        elif self.tipo=="electrica": icono_inmunidad(sup,"inmune_electrica",self.x,self.y,0.75)
        else: pygame.draw.circle(sup,NEGRO,(self.x,self.y),6,2)

    def a_dict(self):
        return {"x":self.x,"y":self.y,"tipo":self.tipo,"nivel":self.nivel,"rango":self.rango,
                "cooldown":self.cooldown,"invertido":self.invertido}

    @classmethod
    def desde_dict(cls,d):
        obj=cls(d["x"],d["y"],d["tipo"]); obj.nivel=max(1,min(5,int(d.get("nivel",1))))
        obj.rango=float(d.get("rango",obj.rango+15*(obj.nivel-1)))
        obj.cooldown=float(d.get("cooldown",0)); obj.danio=obj.danio_base*obj.nivel
        obj.invertido=int(d.get("invertido",obj.costo_base+sum(n*100 for n in range(1,obj.nivel))))
        return obj

