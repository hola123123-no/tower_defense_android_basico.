            with open(ARCHIVO_RECORD,"w",encoding="utf-8") as f: json.dump({"oleada_maxima":record_oleada},f)
        except OSError: mensaje("No se pudo guardar el record")

def generar_oleada(n):
    global multiplicador_dificultad
    ajuste=DIFICULTADES[dificultad_actual]
    multiplicador_dificultad=(1.0+((n-1)//5)*0.50)*ajuste["vida"]
    lista=[]; cantidad=5+n*2
    if n%10==0:
        tipo_jefe="coloso" if n==10 else ("llamas" if n==20 else "destructor")
        lista.append(Enemigo("tanque",multiplicador_dificultad,True,tipo_jefe,n,
                             ajuste["velocidad"],ajuste["vida"]))
        cantidad-=1
    for _ in range(cantidad):
        tipo=random.choice(list(INMUNIDADES)) if n>15 and random.random()<0.25 else random.choice(["normal","veloz","tanque"])
        lista.append(Enemigo(tipo,multiplicador_dificultad,vel_mult=ajuste["velocidad"]))
    return lista

